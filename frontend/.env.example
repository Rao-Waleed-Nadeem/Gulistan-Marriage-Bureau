# ==============================================================================
# Gulistan Marriage Bureau — Frontend Environment Configuration Example
# ==============================================================================
# IMPORTANT SECURITY POLICY:
# - Only variables prefixed with VITE_ are exposed to the browser client bundle.
# - NEVER put service-role keys (SUPABASE_SERVICE_ROLE_KEY) or database connection strings here!
# - If these variables are not provided, the frontend safely defaults to standalone DEMO mode.
# ==============================================================================

# Supabase Public API Gateway URL (Browser-Safe)
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"

# Supabase Anonymous Public Key (Browser-Safe for public endpoints governed by RLS)
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-token-placeholder"

# Environment Mode ('development' | 'staging' | 'production')
VITE_APP_ENV="development"

# Set to "false" to enforce backend connection; defaults to "true" (safe demo mode)
VITE_USE_MOCK_DATA="true"

# ------------------------------------------------------------------------------
# Optional AI Assistant Keys
# ------------------------------------------------------------------------------
# GEMINI_API_KEY: Injected at runtime for AI assistant capabilities
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"
