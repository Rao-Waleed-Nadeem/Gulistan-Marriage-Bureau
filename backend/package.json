{
  "name": "@gulistan/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend tooling, migrations, tests, and configuration for Gulistan Marriage Bureau",
  "scripts": {
    "test": "node --test tests/**/*.test.js",
    "benchmark": "node scripts/capacity-benchmark.js",
    "restore:drill": "node scripts/restore-drill.js",
    "deploy:migrations": "node scripts/deploy-migrations.js",
    "deploy:migrations:live": "node scripts/deploy-migrations.js --live",
    "deploy:migrations:verify": "node scripts/deploy-migrations.js --verify-only",
    "smoke:test": "node scripts/smoke-test.js --demo",
    "migrate:validate": "node scripts/validate-migrations.js",
    "migrate:status": "node scripts/migration-status.js"
  },
  "keywords": [
    "gulistan",
    "marriage-bureau",
    "backend",
    "migrations"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "pg": "^8.23.1"
  }
}
