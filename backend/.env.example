# ==============================================================================
# Gulistan Marriage Bureau — Backend Environment Configuration Example
# ==============================================================================
# IMPORTANT SECURITY NOTICE:
# - This file is a committed template containing variable names and placeholders only.
# - NEVER commit real credentials, service-role keys, passwords, or connection strings.
# - Copy this file to `.env` for local development. `.env` is ignored by Git.
# - Server-only secrets MUST NEVER be shared with browser clients or prefixed with VITE_.
# ==============================================================================

# Application Environment ('development' | 'staging' | 'production')
NODE_ENV="development"

# Server Port (if running local development edge server or mock gateway)
PORT=54321

# Supabase Project Configuration (Adopted via DECIDED: ADR-002 / OPEN-013)
# Approved Cloud Region: Middle East (me-central-1) or Singapore (ap-southeast-1)
SUPABASE_REGION="me-central-1"

# Public API Gateway URL (Safe to use in public client if needed)
SUPABASE_URL="https://your-project-ref.supabase.co"

# Public Anonymous API Key (Browser-safe for public endpoints with RLS)
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-token-placeholder"

# ------------------------------------------------------------------------------
# PRIVILEGED SERVER SECRETS (STRICTLY CONFIDENTIAL — SERVER-SIDE ONLY)
# NEVER EXPOSE TO BROWSER CLIENTS, VITE CONFIGURATION, OR COMMITTED FILES
# ------------------------------------------------------------------------------
# Service Role Secret Key (Bypasses Row-Level Security — Use strictly in trusted server functions)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-token-placeholder"

# Direct PostgreSQL Connection String (For running migration tools and CLI)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL="postgresql://postgres:your-db-password-placeholder@db.your-project-ref.supabase.co:5432/postgres"

# Private Media Storage Bucket (Adopted for candidate photos under OPEN-004)
CANDIDATE_PHOTO_BUCKET="candidate-photos"
